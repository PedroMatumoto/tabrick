# OpenAI API Configuration (Required)
OPENAI_API_KEY=your_openai_api_key_here

# Google Document AI Configuration (Optional - for scanned PDFs)
# Create a project in Google Cloud Console and enable Document AI API
DOCUMENT_AI_PROJECT_ID=your_gcp_project_id
DOCUMENT_AI_LOCATION=us  # or your preferred location
DOCUMENT_AI_PROCESSOR_ID=your_processor_id

# Django Configuration
DEBUG=True
SECRET_KEY=your_secret_key_here
